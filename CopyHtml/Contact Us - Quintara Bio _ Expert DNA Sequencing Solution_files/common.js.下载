//自定义函数
function autoH(className){
	var maxH = 0;
	$(className).each(function() {
    var cutH = $(this).innerHeight();
	if(cutH>maxH){
		maxH = cutH;
		}
    });
    $(className).innerHeight(maxH);
}

function autoW(className){
	var maxW = 0;
	$(className).each(function() {
    var cutW = $(this).innerWidth();
	if(cutW>maxW){
		maxW = cutW;
		}
    });
    $(className).innerWidth(maxW);
}

function addPreZero(num){
	 if(num<10){
	 var t = (num+'').length,
	  s = '';
	 for(var i=0; i<2-t; i++){
	  s += '0';
	 }
	 return s+num;
	 }else{
		 return num;
		 }
}

